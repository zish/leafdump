# MANIFEST.in -- what the source distribution carries beyond the package.
#
# Generated by scripts/manifest_in.py. Edit that script and run
# `make manifest`; editing this file works until the next regeneration
# discards it, and `make manifest-check` fails the moment the two disagree.

# --- external documentation -------------------------------------------------
# README.md and LICENSE arrive on their own -- pyproject.toml names them in
# `readme` and `license-files`. Nothing names these four.

# who wrote it
include AUTHORS.md

# extras, source installs, completion, the manpage
include INSTALL.md

# what is not built yet, and why
include ROADMAP.md

# how to report something -- the first file an auditor opens
include SECURITY.md

# what a major bump means -- the compatibility promise
include VERSIONING.md

# --- installed data files ---------------------------------------------------
# Derived from pyproject.toml's [tool.setuptools.data-files], so the manpage
# and the completions stay named in exactly one place.

# installed into share/zsh/site-functions
include contrib/completions/_leafdump

# installed into share/bash-completion/completions
include contrib/completions/leafdump.bash

# installed into share/fish/vendor_completions.d
include contrib/completions/leafdump.fish

# installed into share/man/man1
include man/leafdump.1

# --- test fixtures ----------------------------------------------------------
# The sdist ships tests/, so it has to ship what the tests read. setuptools
# sweeps *.py from the project root by default and data files not at all,
# which is how a tarball ends up carrying a suite it cannot pass. Patterns
# rather than filenames: another worked example or parity sample needs no
# edit. `make sdist-check` runs the suite from the built tarball, so a group
# that was forgotten fails a gate rather than a release.

# the suite itself, and any data file added beside it
graft tests

# TestTemplates.test_shipped_examples_load_and_render -- asserts, does not
# skip, so this group is the one that fails the build
include contrib/templates/*.json

# what those examples are for
include contrib/templates/*.md

# TestPerlParity.SAMPLES -- fed to both implementations
include contrib/*.json

# --- never ------------------------------------------------------------------
# `graft` takes what is on the disk, and git's ignore rules have no say in a
# source distribution. Last, because MANIFEST.in applies its directives in the
# order it reads them.
global-exclude *.py[cod]
